# Copy to .env (scripts/aws_setup.py does this for you). .env is git-ignored: NEVER commit it.
# Empty values are filled in automatically by the setup scripts.

AWS_REGION=us-east-1
ACCOUNT_ID=
BUCKET_NAME=

# ---- Models behind the gateway's aliases --------------------------------------------
# Any LiteLLM model string. Defaults are low-cost Amazon Nova models on Bedrock.
# Examples: bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0, bedrock/us.meta.llama3-3-70b-instruct-v1:0,
#           openai/gpt-4.1-mini (needs OPENAI_API_KEY below). Pick models that support tool calling.
# After changing these, restart the gateway: docker compose up -d
FAST_MODEL=bedrock/us.amazon.nova-micro-v1:0
SMART_MODEL=bedrock/us.amazon.nova-2-lite-v1:0
FALLBACK_MODEL=bedrock/us.amazon.nova-pro-v1:0
# A Bedrock model that is NOT behind any alias, used by test ID-3 to show the gateway's
# identity can reach it anyway. Keep it cheap and different from the three above.
REACH_TEST_MODEL=us.amazon.nova-lite-v1:0

# Optional API keys for non-Bedrock providers (leave empty if you only use Bedrock)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Identities (created by scripts/aws_setup.py) ------------------------------------
# Gateway identity: used only inside the LiteLLM container to call Bedrock
LITELLM_GATEWAY_AWS_ACCESS_KEY_ID=
LITELLM_GATEWAY_AWS_SECRET_ACCESS_KEY=
# Agent identity: ONE identity shared by both agents (weakness ID-1)
AGENT_RUNTIME_AWS_ACCESS_KEY_ID=
AGENT_RUNTIME_AWS_SECRET_ACCESS_KEY=

# ---- LiteLLM gateway ------------------------------------------------------------------
LITELLM_URL=http://localhost:4000
# Matches the value committed in litellm/config.yaml (weakness ID-4)
LITELLM_MASTER_KEY=sk-mvhp-demo-master-0001
# Encrypts anything LiteLLM stores in Postgres. Generated once; never change it afterwards.
LITELLM_SALT_KEY=
# Virtual keys for the two agents (created by scripts/create_keys.py)
MEMBER_VKEY=
CLAIMS_VKEY=

# Offline tool testing only: s3 (normal) or local (read data/ and policies/ from disk)
DATA_SOURCE=s3
