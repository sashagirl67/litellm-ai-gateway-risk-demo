{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OverlyBroadListWholeBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::{{BUCKET}}"
    },
    {
      "Sid": "OverlyBroadReadWholeBucketIncludingPHI",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::{{BUCKET}}/*"
    }
  ]
}
